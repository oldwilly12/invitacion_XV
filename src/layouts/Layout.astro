---
import '../styles/global.css';
import { event } from '../data/event';
import EnvelopeIntro from '../components/EnvelopeIntro.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `Invitación XV Años | ${event.quinceañera}`,
  description = 'Acompáñanos a celebrar mis XV años.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#4A5D23" />
    <title>{title}</title>
  </head>
  <body>
    <EnvelopeIntro />

    <div class="page">
      <audio id="bg-music" src={event.musica.src} loop preload="none"></audio>
      <slot />
    </div>
  </body>
</html>

<style>
  .page {
    min-height: 100dvh;
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
    background: var(--bg-base);
    overflow-x: hidden;
    box-shadow: 0 0 40px rgba(74, 93, 35, 0.08);
  }

  /* En pantallas grandes, la invitación queda centrada como una "tarjeta" móvil */
  @media (min-width: 481px) {
    body {
      background: var(--bg-deep);
    }
  }
</style>
