---
import { event } from '../data/event';
---

<section class="section rsvp">
  <p class="eyebrow">Confirma tu asistencia</p>
  <hr class="divider" />
  <p class="deadline">Antes del {event.rsvp.fechaLimite}</p>

  <p id="rsvp-pases" class="pases" data-default={event.rsvp.pasesPorDefecto}>
    Tienes <span class="pases-num">0</span> pases
  </p>

  <form id="rsvp-form" class="rsvp-form" data-whatsapp={event.rsvp.whatsapp}>
    <input
      type="text"
      name="nombre"
      placeholder="Tu nombre completo"
      required
    />
    <button type="submit" class="cta">Confirmar por WhatsApp</button>
  </form>

  <div id="rsvp-success" class="rsvp-success" hidden>
    <p class="success-title">¡Gracias, <span class="rsvp-success-name">​</span>!</p>
    <p class="success-note">Tu confirmación se envió por WhatsApp. ¡Te esperamos! 💚</p>
  </div>
</section>

<div
  id="rsvp-fullscreen"
  class="rsvp-fullscreen"
  role="button"
  tabindex="0"
  aria-label="Cerrar y volver a la invitación"
  hidden
>
  <div class="fs-badge">
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 25l8 8 16-18" />
    </svg>
  </div>

  <p class="fs-title">¡Gracias, <span class="rsvp-success-name">​</span>!</p>
  <p class="fs-note">Tu confirmación se envió por WhatsApp.<br />¡Te esperamos! 💚</p>

  <p class="fs-hint">Toca para continuar</p>
</div>

<style>
  .deadline {
    font-size: 0.8rem;
    opacity: 0.75;
    margin-bottom: 0.75rem;
  }

  .pases {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--text-heading);
    margin: 0 0 1.5rem;
  }

  .pases-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.2rem;
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 700;
    font-size: 2.1rem;
    line-height: 1;
    color: var(--color-cream);
    background: var(--color-olive-dark);
    border: 2px solid var(--accent-gold);
    border-radius: 10px;
    padding: 0.4rem 0.9rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .rsvp-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .rsvp-form input {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--frame);
    border-radius: 8px;
    background: var(--bg-base);
    color: var(--text-body);
    font-family: var(--font-body);
    font-size: 0.9rem;
  }

  .rsvp-form input::placeholder {
    color: var(--text-heading);
    opacity: 0.5;
  }

  .cta {
    padding: 0.85rem 2rem;
    border: 1px solid var(--accent-gold);
    border-radius: 999px;
    background: var(--color-olive-dark);
    color: var(--color-cream);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .cta:hover {
    opacity: 0.85;
  }

  .rsvp-success {
    padding: 1.25rem;
    border: 1px solid var(--accent-gold-soft);
    border-radius: 8px;
    background: var(--bg-base);
  }

  .success-title {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.3rem;
    color: var(--accent-gold);
    margin: 0 0 0.5rem;
  }

  .success-note {
    font-size: 0.9rem;
    color: var(--text-body);
    margin: 0;
  }

  /* --- Pantalla completa al confirmar --- */
  .rsvp-fullscreen {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1.1rem;
    padding: 2rem;
    text-align: center;
    cursor: pointer;
    background:
      radial-gradient(circle at 50% 30%, rgba(212, 175, 55, 0.12), transparent 60%),
      linear-gradient(160deg, var(--color-olive-dark) 0%, var(--color-olive) 60%, var(--color-olive-soft) 100%);
    opacity: 1;
    transition: opacity 0.5s ease;
  }

  /* El atributo `hidden` es el estado seguro por defecto (sin JS, o antes
     de que corra el script, no debe cubrir la invitación). El `display: grid`
     de arriba tiene más prioridad que el `[hidden]` del navegador, así que
     hay que restaurarlo explícitamente aquí. */
  .rsvp-fullscreen[hidden] {
    display: none;
  }

  .rsvp-fullscreen.is-closing {
    opacity: 0;
    pointer-events: none;
  }

  .fs-badge {
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: var(--color-cream);
    border: 2px solid var(--accent-gold);
    color: var(--color-olive-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
  }

  .fs-badge svg {
    width: 2.2rem;
    height: 2.2rem;
  }

  .fs-title {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.9rem;
    color: var(--accent-gold);
    margin: 0.5rem 0 0;
  }

  .fs-note {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-cream);
    margin: 0;
  }

  .fs-hint {
    margin: 1.5rem 0 0;
    font-size: 0.7rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--color-cream);
    opacity: 0.6;
  }
</style>

<script>
  const STORAGE_KEY = 'rsvp-confirmado';

  const form = document.getElementById('rsvp-form') as HTMLFormElement | null;
  const success = document.getElementById('rsvp-success');
  const fullscreen = document.getElementById('rsvp-fullscreen');
  const nameSlots = document.querySelectorAll('.rsvp-success-name');
  const pasesEl = document.getElementById('rsvp-pases');
  const pasesNumEl = document.querySelector('.pases-num');

  function getPases(): number {
    const fallback = Number(pasesEl?.dataset.default) || 1;
    const raw = new URLSearchParams(window.location.search).get('pases');
    const n = Number(raw);
    if (!raw || !Number.isInteger(n) || n < 1) return fallback;
    return Math.min(n, 20);
  }

  const pases = getPases();
  if (pasesNumEl) {
    pasesNumEl.textContent = String(pases);
  }

  function setNombre(nombre: string) {
    nameSlots.forEach((slot) => {
      slot.textContent = nombre;
    });
  }

  function showInlineSuccess() {
    if (form) form.hidden = true;
    if (success) success.hidden = false;
  }

  function showFullscreen() {
    if (!fullscreen) return;
    fullscreen.hidden = false;
    fullscreen.classList.remove('is-closing');
  }

  function hideFullscreen() {
    if (!fullscreen || fullscreen.hidden) return;
    fullscreen.classList.add('is-closing');
    window.setTimeout(() => {
      fullscreen.hidden = true;
    }, 500);
  }

  fullscreen?.addEventListener('click', hideFullscreen);
  fullscreen?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      hideFullscreen();
    }
  });

  const guardado = localStorage.getItem(STORAGE_KEY);
  if (guardado) {
    try {
      const { nombre } = JSON.parse(guardado);
      setNombre(nombre);
      showInlineSuccess();
    } catch {
      // dato guardado inválido, se ignora
    }
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const phone = form.dataset.whatsapp;
    const data = new FormData(form);
    const nombre = String(data.get('nombre') ?? '').trim();
    if (!nombre) return;

    const text = encodeURIComponent(
      `¡Hola! Confirmo mi asistencia 🎉\nNombre: ${nombre}\nPases: ${pases}`
    );

    localStorage.setItem(STORAGE_KEY, JSON.stringify({ nombre }));
    setNombre(nombre);
    showInlineSuccess();
    showFullscreen();

    window.open(`https://wa.me/${phone}?text=${text}`, '_blank');
  });
</script>
