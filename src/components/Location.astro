---
import { event } from '../data/event';

const { mapsEmbedUrl, mapsSearchUrl } = event.ubicacion;
---

<section class="section location">
  <p class="eyebrow">Ubicación</p>
  <hr class="divider" />
  <h2 class="venue">{event.ubicacion.nombre}</h2>
  <p class="address">{event.ubicacion.direccion}</p>

  <div class="map-frame">
    <iframe
      src={mapsEmbedUrl}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      title={`Mapa de ${event.ubicacion.nombre}`}
    ></iframe>
  </div>

  <a class="cta" href={mapsSearchUrl} target="_blank" rel="noopener noreferrer">
    Cómo llegar
  </a>
</section>

<style>
  .venue {
    font-size: 1.2rem;
  }

  .address {
    font-size: 0.9rem;
    opacity: 0.85;
    margin-bottom: 1.5rem;
  }

  .map-frame {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--frame);
  }

  .map-frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .cta {
    display: inline-block;
    margin-top: 1.5rem;
    padding: 0.75rem 2rem;
    border: 1px solid var(--frame);
    border-radius: 999px;
    color: var(--text-heading);
    text-decoration: none;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .cta:hover {
    background: var(--frame);
    color: var(--bg-base);
  }
</style>
