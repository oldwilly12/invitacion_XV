---
import { event } from '../data/event';
---

<section class="section adults-only">
  <img class="bg-flowers" src="/images/flores_contorno.png" alt="" aria-hidden="true" />

  <div class="content">
    <h2 class="title">{event.soloAdultos.titulo}</h2>
    <hr class="divider" />

    <p class="intro">{event.soloAdultos.intro}</p>
    <p class="message">{event.soloAdultos.mensaje}</p>

    <div class="badge">
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="24" cy="24" r="16" />
        <circle cx="17.5" cy="18" r="3.2" />
        <path d="M13 32l2-11.5h5l2 11.5" fill="currentColor" stroke="none" />
        <circle cx="30" cy="15.5" r="3.6" />
        <path d="M25 32l1.6-13h6.8l1.6 13" fill="currentColor" stroke="none" />
        <line x1="9" y1="39" x2="39" y2="9" stroke-width="3" />
      </svg>
    </div>

    <p class="closing">{event.soloAdultos.cierre}</p>
  </div>
</section>

<style>
  .adults-only {
    position: relative;
    overflow: hidden;
    background: var(--bg-base);
  }

  .bg-flowers {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.16;
    pointer-events: none;
    z-index: 0;
  }

  .content {
    position: relative;
    z-index: 1;
  }

  .title {
    font-size: 2rem;
    font-style: italic;
    color: var(--accent-gold);
  }

  .intro {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--text-heading);
    margin-bottom: 1rem;
  }

  .message {
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--text-body);
  }

  .badge {
    width: 4.5rem;
    height: 4.5rem;
    margin: 2rem auto;
    border-radius: 50%;
    background: var(--color-olive-dark);
    border: 2px solid var(--accent-gold);
    color: var(--color-cream);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px rgba(74, 93, 35, 0.25);
  }

  .badge svg {
    width: 2.4rem;
    height: 2.4rem;
  }

  .closing {
    font-size: 0.9rem;
    line-height: 1.75;
    color: var(--text-body);
    opacity: 0.9;
  }
</style>
